{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "~/.config/fastfetch/Aero_Plane.txt",
        "padding": { "top": 1, "right": 3 }
    },
    "modules": [
        { "type": "title", "keyWidth": 0 },
        "separator",
        { "type": "os" },
        { "type": "host" },
        { "type": "kernel" },
        { "type": "uptime" },
        { "type": "shell" },
        { "type": "de" },
        { "type": "terminal" },
        { "type": "cpu" },
        { "type": "memory", "showPercentage": false },
        { "type": "colors", "symbol": "circle", "paddingLeft": 2 }
    ]
}